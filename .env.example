# Public website inputs (Phase 23). None of these is invented by the project — set the real values at build time.
# Production origin, no trailing slash. Enables canonical URLs, og:url, JSON-LD and sitemap.xml. Without it those are NOT generated.
VITE_SITE_URL=
# Optional: legal entity name / postal address / public contact e-mail shown in the footer, About and Contact pages.
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_ADDRESS=
VITE_CONTACT_EMAIL=
# Contact form target. Leave empty to use <API base>/public/contact (the backend endpoint added in Phase 24; it answers 503 until the backend has SMTP configured).
# Set to "off" to disable the endpoint and fall back to mailto / the "not configured" notice.
VITE_CONTACT_ENDPOINT=
# Backend API base URL, baked into the build (public — never put secrets in VITE_* variables).
#   production, same origin behind the reverse proxy:  leave empty (uses "/api")   or   VITE_API_BASE_URL=/api
#   production, separate API host:                      VITE_API_BASE_URL=https://api.example.com/api   (and CORS_ORIGIN on the backend = this site's origin)
#   development:                                        empty → http://localhost:5000/api
# A production build FAILS if this points at localhost / 127.0.0.1.
VITE_API_BASE_URL=
